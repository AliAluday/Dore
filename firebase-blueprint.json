{
  "entities": {
    "PlatformConfig": {
      "title": "PlatformConfig",
      "description": "Global platform feature toggles, disabled categories, and live announcements managed by Control App admins and read by all users.",
      "type": "object",
      "properties": {
        "allowNewBookings": { "type": "boolean" },
        "enableFastestTurn": { "type": "boolean" },
        "enableQrCode": { "type": "boolean" },
        "enableWhatsAppShare": { "type": "boolean" },
        "enableReviews": { "type": "boolean" },
        "enableLoyalty": { "type": "boolean" },
        "enableOptionalFields": { "type": "boolean" },
        "enableLiveAlerts": { "type": "boolean" },
        "pointsPerBooking": { "type": "integer" },
        "disabledCategories": { "type": "array" },
        "broadcastMessage": { "type": "string" },
        "controlRevision": { "type": "integer" },
        "queueResetRevision": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "allowNewBookings", "enableFastestTurn", "enableQrCode", "enableWhatsAppShare",
        "enableReviews", "enableLoyalty", "enableOptionalFields", "enableLiveAlerts",
        "pointsPerBooking", "disabledCategories", "broadcastMessage",
        "controlRevision", "queueResetRevision", "createdAt", "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private per-user profile, notification preferences, personal favorites, and earned loyalty points.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "selectedDistrict": { "type": "string" },
        "isDarkMode": { "type": "boolean" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "userAge": { "type": "string" },
        "optionalNote": { "type": "string" },
        "loyaltyPoints": { "type": "integer" },
        "muteSound": { "type": "boolean" },
        "muteVibration": { "type": "boolean" },
        "favoriteVenueIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "email", "selectedDistrict", "isDarkMode", "userName", "userPhone",
        "userAge", "optionalNote", "loyaltyPoints", "muteSound", "muteVibration",
        "favoriteVenueIds", "createdAt", "updatedAt"
      ]
    },
    "Venue": {
      "title": "Venue",
      "description": "Shared public Nineveh service center directory entry and live queue counters.",
      "type": "object",
      "properties": {
        "venueId": { "type": "integer" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "category": { "type": "string" },
        "specialty": { "type": "string" },
        "area": { "type": "string" },
        "priceDinar": { "type": "integer" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "workingHours": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "description": { "type": "string" },
        "customOptionsCsv": { "type": "string" },
        "open": { "type": "boolean" },
        "paused": { "type": "boolean" },
        "acceptingBookings": { "type": "boolean" },
        "currentServingNumber": { "type": "integer" },
        "nextTicketNumber": { "type": "integer" },
        "servedTodayCount": { "type": "integer" },
        "avgMinutesPerPerson": { "type": "integer" },
        "waitingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "venueId", "name", "city", "category", "specialty", "area", "priceDinar",
        "rating", "reviewCount", "workingHours", "phone", "whatsapp", "latitude", "longitude",
        "description", "customOptionsCsv", "open", "paused", "acceptingBookings",
        "currentServingNumber", "nextTicketNumber", "servedTodayCount", "avgMinutesPerPerson",
        "waitingCount", "createdAt", "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Customer queue ticket booking owned by userId and managed in real time by Control App admins.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookingId": { "type": "integer" },
        "ticketCode": { "type": "string" },
        "queueNumber": { "type": "integer" },
        "venueId": { "type": "integer" },
        "venueName": { "type": "string" },
        "venueCity": { "type": "string" },
        "venueCategory": { "type": "string" },
        "venuePhone": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "selectedOption": { "type": "string" },
        "notes": { "type": "string" },
        "optionalInfo": { "type": "string" },
        "priceDinar": { "type": "integer" },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "CANCELLED"] },
        "stage": { "type": "string", "enum": ["MONITORED", "APPROACHING", "YOUR_TURN"] },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
        "handledByProvider": { "type": "string" },
        "approvalNote": { "type": "string" },
        "peopleAhead": { "type": "integer" },
        "estimatedMinutes": { "type": "integer" },
        "createdAtMillis": { "type": "integer" },
        "completedAtMillis": { "type": "integer" },
        "userRating": { "type": "integer" },
        "userReview": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "bookingId", "ticketCode", "queueNumber", "venueId", "venueName",
        "venueCity", "venueCategory", "venuePhone", "customerName", "customerPhone",
        "selectedOption", "notes", "optionalInfo", "priceDinar", "status", "stage",
        "approvalStatus", "handledByProvider", "approvalNote",
        "peopleAhead", "estimatedMinutes", "createdAtMillis", "createdAt", "updatedAt"
      ]
    },
    "QueueItem": {
      "title": "QueueItem",
      "description": "Live venue queue entry linked to a customer booking or walk-in customer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "queueItemId": { "type": "integer" },
        "venueId": { "type": "integer" },
        "ticketNumber": { "type": "integer" },
        "ticketCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "selectedOption": { "type": "string" },
        "status": { "type": "string", "enum": ["WAITING", "SERVING", "DONE", "SKIPPED", "NO_SHOW"] },
        "bookingId": { "type": "integer" },
        "bookingTicketCode": { "type": "string" },
        "createdAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "queueItemId", "venueId", "ticketNumber", "ticketCode",
        "customerName", "customerPhone", "selectedOption", "status",
        "createdAtMillis", "createdAt", "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Public verified customer rating and comment for a Nineveh venue.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reviewId": { "type": "integer" },
        "venueId": { "type": "integer" },
        "authorName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "reviewId", "venueId", "authorName", "rating", "comment",
        "createdAtMillis", "createdAt", "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support conversation or complaint ticket visible only to its owner (userId) and Control App admins.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "externalId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhone": { "type": "string" },
        "category": { "type": "string", "enum": ["COMPLAINT", "BOOKING_ISSUE", "TECHNICAL", "VENUE_REPORT", "SUGGESTION", "GENERAL"] },
        "requestType": { "type": "string", "enum": ["CHAT", "COMPLAINT"] },
        "relatedVenueName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["SENT", "DELIVERED", "IN_REVIEW", "REPLIED", "CLOSED"] },
        "adminReply": { "type": "string" },
        "repliedByAdmin": { "type": "string" },
        "createdAtMillis": { "type": "integer" },
        "updatedAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "externalId", "senderName", "senderPhone", "category", "requestType",
        "relatedVenueName", "subject", "message", "status", "adminReply", "repliedByAdmin",
        "createdAtMillis", "updatedAtMillis", "createdAt", "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Append-only chat message in a support thread carrying the customer owner's userId.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "externalMessageId": { "type": "string" },
        "ticketExternalId": { "type": "string" },
        "fromAdmin": { "type": "boolean" },
        "senderName": { "type": "string" },
        "body": { "type": "string" },
        "createdAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "externalMessageId", "ticketExternalId", "fromAdmin",
        "senderName", "body", "createdAtMillis", "createdAt", "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized Firebase Auth UID granted access to the Dori Control App.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Control app operator profile and granular UI permissions.",
      "type": "object",
      "properties": {
        "adminId": { "type": "integer" },
        "name": { "type": "string" },
        "roleTitle": { "type": "string" },
        "phone": { "type": "string" },
        "active": { "type": "boolean" },
        "superAdmin": { "type": "boolean" },
        "canManageFeatures": { "type": "boolean" },
        "canManageVenues": { "type": "boolean" },
        "canManageQueues": { "type": "boolean" },
        "canReplySupport": { "type": "boolean" },
        "canManageProviders": { "type": "boolean" },
        "canManageAdmins": { "type": "boolean" },
        "canRunCommands": { "type": "boolean" },
        "createdAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "adminId", "name", "roleTitle", "phone", "active", "superAdmin",
        "canManageFeatures", "canManageVenues", "canManageQueues", "canReplySupport",
        "canManageProviders", "canManageAdmins", "canRunCommands",
        "createdAtMillis", "createdAt", "updatedAt"
      ]
    },
    "ServiceProvider": {
      "title": "ServiceProvider",
      "description": "Control app service provider account linked to a Nineveh venue.",
      "type": "object",
      "properties": {
        "providerId": { "type": "integer" },
        "name": { "type": "string" },
        "providerRole": { "type": "string" },
        "customTitle": { "type": "string" },
        "phone": { "type": "string" },
        "venueId": { "type": "integer" },
        "venueName": { "type": "string" },
        "canAcceptTickets": { "type": "boolean" },
        "canCallNext": { "type": "boolean" },
        "canPauseVenue": { "type": "boolean" },
        "active": { "type": "boolean" },
        "acceptedCount": { "type": "integer" },
        "createdAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "providerId", "name", "providerRole", "customTitle", "phone",
        "venueId", "venueName", "canAcceptTickets", "canCallNext", "canPauseVenue",
        "active", "acceptedCount", "createdAtMillis", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/platform/{configId}": {
      "schema": { "$ref": "#/entities/PlatformConfig" },
      "description": "Global platform configuration under /platform/settings."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private per-user profile, preferences, favorites, and loyalty points."
    },
    "/venues/{venueDocId}": {
      "schema": { "$ref": "#/entities/Venue" },
      "description": "Shared public Nineveh service centers and real-time queue counters."
    },
    "/bookings/{bookingDocId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Top-level customer bookings scoped by userId (owner) and accessible to Control App admins."
    },
    "/queue_items/{queueDocId}": {
      "schema": { "$ref": "#/entities/QueueItem" },
      "description": "Top-level live queue items scoped by userId (owner) and managed by Control App admins."
    },
    "/reviews/{reviewDocId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public customer reviews for Nineveh venues."
    },
    "/support_tickets/{ticketDocId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Two-way customer support threads scoped by customer userId and accessible to Control App admins."
    },
    "/support_messages/{messageDocId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Append-only chat messages scoped by customer userId and accessible to Control App admins."
    },
    "/admin_users/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "RBAC registry of authorized Control App admin Google accounts."
    },
    "/admins/{adminDocId}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Control App staff operator profiles."
    },
    "/providers/{providerDocId}": {
      "schema": { "$ref": "#/entities/ServiceProvider" },
      "description": "Control App linked doctors, merchants, and venue providers."
    }
  }
}
