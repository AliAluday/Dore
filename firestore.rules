rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token &&
        request.auth.token.email == 'alialhadidia2008@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    function isValidPlatformConfig(data) {
      return data.allowNewBookings is bool &&
        data.enableFastestTurn is bool &&
        data.enableQrCode is bool &&
        data.enableWhatsAppShare is bool &&
        data.enableReviews is bool &&
        data.enableLoyalty is bool &&
        data.enableOptionalFields is bool &&
        data.enableLiveAlerts is bool &&
        data.pointsPerBooking is int && data.pointsPerBooking >= 0 && data.pointsPerBooking <= 100 &&
        data.disabledCategories is list && data.disabledCategories.size() <= 10 &&
        (data.disabledCategories.size() == 0 || data.disabledCategories[0] is string) &&
        data.broadcastMessage is string && data.broadcastMessage.size() <= 300 &&
        data.controlRevision is int && data.controlRevision >= 0 &&
        data.queueResetRevision is int && data.queueResetRevision >= 0;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.email is string && data.email.size() <= 160 &&
        data.selectedDistrict is string && data.selectedDistrict.size() <= 80 &&
        data.isDarkMode is bool &&
        data.userName is string && data.userName.size() <= 100 &&
        data.userPhone is string && data.userPhone.size() <= 30 &&
        data.userAge is string && data.userAge.size() <= 20 &&
        data.optionalNote is string && data.optionalNote.size() <= 300 &&
        data.loyaltyPoints is int && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 100000 &&
        data.muteSound is bool &&
        data.muteVibration is bool &&
        data.favoriteVenueIds is list && data.favoriteVenueIds.size() <= 200 &&
        (data.favoriteVenueIds.size() == 0 || data.favoriteVenueIds[0] is int);
    }

    function isValidVenue(data) {
      return data.venueId is int && data.venueId > 0 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        data.specialty is string && data.specialty.size() <= 80 &&
        data.area is string && data.area.size() >= 1 && data.area.size() <= 80 &&
        data.priceDinar is int && data.priceDinar >= 0 && data.priceDinar <= 500000 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 100000 &&
        data.workingHours is string && data.workingHours.size() <= 80 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.whatsapp is string && data.whatsapp.size() <= 30 &&
        data.latitude is number &&
        data.longitude is number &&
        data.description is string && data.description.size() <= 500 &&
        data.customOptionsCsv is string && data.customOptionsCsv.size() <= 500 &&
        data.open is bool &&
        data.paused is bool &&
        data.acceptingBookings is bool &&
        data.currentServingNumber is int && data.currentServingNumber >= 0 && data.currentServingNumber <= 10000 &&
        data.nextTicketNumber is int && data.nextTicketNumber >= 1 && data.nextTicketNumber <= 10001 &&
        data.servedTodayCount is int && data.servedTodayCount >= 0 && data.servedTodayCount <= 10000 &&
        data.avgMinutesPerPerson is int && data.avgMinutesPerPerson >= 1 && data.avgMinutesPerPerson <= 180 &&
        data.waitingCount is int && data.waitingCount >= 0 && data.waitingCount <= 10000;
    }

    function isValidBooking(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.bookingId is int && data.bookingId > 0 &&
        data.ticketCode is string && data.ticketCode.size() >= 1 && data.ticketCode.size() <= 40 &&
        data.queueNumber is int && data.queueNumber >= 1 && data.queueNumber <= 10000 &&
        data.venueId is int && data.venueId > 0 &&
        data.venueName is string && data.venueName.size() >= 1 && data.venueName.size() <= 120 &&
        data.venueCity is string && data.venueCity.size() <= 120 &&
        data.venueCategory is string && data.venueCategory.size() <= 40 &&
        data.venuePhone is string && data.venuePhone.size() <= 30 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() >= 1 && data.customerPhone.size() <= 30 &&
        data.selectedOption is string && data.selectedOption.size() <= 120 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.optionalInfo is string && data.optionalInfo.size() <= 300 &&
        data.priceDinar is int && data.priceDinar >= 0 && data.priceDinar <= 500000 &&
        data.status in ['ACTIVE', 'COMPLETED', 'CANCELLED'] &&
        data.stage in ['MONITORED', 'APPROACHING', 'YOUR_TURN'] &&
        data.approvalStatus in ['PENDING', 'ACCEPTED', 'REJECTED'] &&
        data.handledByProvider is string && data.handledByProvider.size() <= 120 &&
        data.approvalNote is string && data.approvalNote.size() <= 300 &&
        data.peopleAhead is int && data.peopleAhead >= 0 && data.peopleAhead <= 10000 &&
        data.estimatedMinutes is int && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 10000 &&
        data.createdAtMillis is int && data.createdAtMillis >= 0 &&
        (!('completedAtMillis' in data) || data.completedAtMillis == null || (data.completedAtMillis is int && data.completedAtMillis >= 0)) &&
        (!('userRating' in data) || data.userRating == null || (data.userRating is int && data.userRating >= 1 && data.userRating <= 5)) &&
        (!('userReview' in data) || data.userReview == null || (data.userReview is string && data.userReview.size() <= 400));
    }

    function isValidQueueItem(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.queueItemId is int && data.queueItemId > 0 &&
        data.venueId is int && data.venueId > 0 &&
        data.ticketNumber is int && data.ticketNumber >= 1 && data.ticketNumber <= 10000 &&
        data.ticketCode is string && data.ticketCode.size() >= 1 && data.ticketCode.size() <= 40 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() <= 30 &&
        data.selectedOption is string && data.selectedOption.size() <= 120 &&
        data.status in ['WAITING', 'SERVING', 'DONE', 'SKIPPED', 'NO_SHOW'] &&
        (!('bookingId' in data) || data.bookingId == null || (data.bookingId is int && data.bookingId > 0)) &&
        (!('bookingTicketCode' in data) || data.bookingTicketCode == null || (data.bookingTicketCode is string && data.bookingTicketCode.size() <= 40)) &&
        data.createdAtMillis is int && data.createdAtMillis >= 0;
    }

    function isValidReview(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.reviewId is int && data.reviewId > 0 &&
        data.venueId is int && data.venueId > 0 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() <= 400 &&
        data.createdAtMillis is int && data.createdAtMillis >= 0;
    }

    function isValidSupportTicket(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.externalId is string && data.externalId.size() >= 1 && data.externalId.size() <= 64 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.senderPhone is string && data.senderPhone.size() <= 30 &&
        data.category in ['COMPLAINT', 'BOOKING_ISSUE', 'TECHNICAL', 'VENUE_REPORT', 'SUGGESTION', 'GENERAL'] &&
        data.requestType in ['CHAT', 'COMPLAINT'] &&
        data.relatedVenueName is string && data.relatedVenueName.size() <= 120 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.status in ['SENT', 'DELIVERED', 'IN_REVIEW', 'REPLIED', 'CLOSED'] &&
        data.adminReply is string && data.adminReply.size() <= 1000 &&
        data.repliedByAdmin is string && data.repliedByAdmin.size() <= 120 &&
        data.createdAtMillis is int && data.createdAtMillis >= 0 &&
        data.updatedAtMillis is int && data.updatedAtMillis >= 0;
    }

    function isValidSupportMessage(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.externalMessageId is string && data.externalMessageId.size() >= 1 && data.externalMessageId.size() <= 80 &&
        data.ticketExternalId is string && data.ticketExternalId.size() >= 1 && data.ticketExternalId.size() <= 64 &&
        data.fromAdmin is bool &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
        data.createdAtMillis is int && data.createdAtMillis >= 0;
    }

    function isValidAdminUser(data, adminUid) {
      return data.uid == adminUid &&
        data.email is string && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'ADMIN'];
    }

    function isValidAdminProfile(data) {
      return data.adminId is int && data.adminId > 0 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 120 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.active is bool &&
        data.superAdmin is bool &&
        data.canManageFeatures is bool &&
        data.canManageVenues is bool &&
        data.canManageQueues is bool &&
        data.canReplySupport is bool &&
        data.canManageProviders is bool &&
        data.canManageAdmins is bool &&
        data.canRunCommands is bool &&
        data.createdAtMillis is int && data.createdAtMillis >= 0;
    }

    function isValidProvider(data) {
      return data.providerId is int && data.providerId > 0 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.providerRole is string && data.providerRole.size() >= 1 && data.providerRole.size() <= 40 &&
        data.customTitle is string && data.customTitle.size() >= 1 && data.customTitle.size() <= 80 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.venueId is int && data.venueId > 0 &&
        data.venueName is string && data.venueName.size() >= 1 && data.venueName.size() <= 120 &&
        data.canAcceptTickets is bool &&
        data.canCallNext is bool &&
        data.canPauseVenue is bool &&
        data.active is bool &&
        data.acceptedCount is int && data.acceptedCount >= 0 && data.acceptedCount <= 1000000 &&
        data.createdAtMillis is int && data.createdAtMillis >= 0;
    }

    // ==================== Global Platform Config ====================
    match /platform/{configId} {
      allow get: if isSignedIn() && configId == 'settings';
      allow list, delete: if false;

      allow create: if isAdmin() &&
        configId == 'settings' &&
        incoming().keys().hasAll([
          'allowNewBookings', 'enableFastestTurn', 'enableQrCode', 'enableWhatsAppShare',
          'enableReviews', 'enableLoyalty', 'enableOptionalFields', 'enableLiveAlerts',
          'pointsPerBooking', 'disabledCategories', 'broadcastMessage',
          'controlRevision', 'queueResetRevision', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'allowNewBookings', 'enableFastestTurn', 'enableQrCode', 'enableWhatsAppShare',
          'enableReviews', 'enableLoyalty', 'enableOptionalFields', 'enableLiveAlerts',
          'pointsPerBooking', 'disabledCategories', 'broadcastMessage',
          'controlRevision', 'queueResetRevision', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidPlatformConfig(incoming());

      allow update: if isAdmin() &&
        configId == 'settings' &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidPlatformConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'allowNewBookings', 'enableFastestTurn', 'enableQrCode', 'enableWhatsAppShare',
          'enableReviews', 'enableLoyalty', 'enableOptionalFields', 'enableLiveAlerts',
          'pointsPerBooking', 'disabledCategories', 'broadcastMessage',
          'controlRevision', 'queueResetRevision', 'updatedAt'
        ]);
    }

    // ==================== Private Per-User Profile ====================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow delete: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'email', 'selectedDistrict', 'isDarkMode', 'userName', 'userPhone',
          'userAge', 'optionalNote', 'loyaltyPoints', 'muteSound', 'muteVibration',
          'favoriteVenueIds', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'email', 'selectedDistrict', 'isDarkMode', 'userName', 'userPhone',
          'userAge', 'optionalNote', 'loyaltyPoints', 'muteSound', 'muteVibration',
          'favoriteVenueIds', 'createdAt', 'updatedAt'
        ]) &&
        incoming().loyaltyPoints == 0 &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidUserProfile(incoming(), userId);

      allow update: if isValidId(userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidUserProfile(incoming(), userId) && (
          (isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'selectedDistrict', 'isDarkMode', 'userName', 'userPhone', 'userAge',
              'optionalNote', 'muteSound', 'muteVibration', 'favoriteVenueIds', 'loyaltyPoints', 'updatedAt'
            ]) &&
            incoming().loyaltyPoints >= existing().loyaltyPoints &&
            incoming().loyaltyPoints <= existing().loyaltyPoints + 100) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyPoints', 'updatedAt']))
        );
    }

    // ==================== Shared Public Venues Directory ====================
    match /venues/{venueDocId} {
      allow get: if isSignedIn() && isValidId(venueDocId);
      allow list: if isSignedIn();
      allow delete: if isAdmin() && isValidId(venueDocId);

      allow create: if isAdmin() &&
        isValidId(venueDocId) &&
        incoming().keys().hasAll([
          'venueId', 'name', 'city', 'category', 'specialty', 'area', 'priceDinar',
          'rating', 'reviewCount', 'workingHours', 'phone', 'whatsapp', 'latitude', 'longitude',
          'description', 'customOptionsCsv', 'open', 'paused', 'acceptingBookings',
          'currentServingNumber', 'nextTicketNumber', 'servedTodayCount', 'avgMinutesPerPerson',
          'waitingCount', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'venueId', 'name', 'city', 'category', 'specialty', 'area', 'priceDinar',
          'rating', 'reviewCount', 'workingHours', 'phone', 'whatsapp', 'latitude', 'longitude',
          'description', 'customOptionsCsv', 'open', 'paused', 'acceptingBookings',
          'currentServingNumber', 'nextTicketNumber', 'servedTodayCount', 'avgMinutesPerPerson',
          'waitingCount', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidVenue(incoming());

      allow update: if isSignedIn() &&
        isValidId(venueDocId) &&
        incoming().venueId == existing().venueId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidVenue(incoming()) && (
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'city', 'category', 'specialty', 'area', 'priceDinar', 'rating',
              'reviewCount', 'workingHours', 'phone', 'whatsapp', 'latitude', 'longitude',
              'description', 'customOptionsCsv', 'open', 'paused', 'acceptingBookings',
              'currentServingNumber', 'nextTicketNumber', 'servedTodayCount', 'avgMinutesPerPerson',
              'waitingCount', 'updatedAt'
            ])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly([
              'currentServingNumber', 'nextTicketNumber', 'waitingCount',
              'servedTodayCount', 'rating', 'reviewCount', 'updatedAt'
            ]) &&
            incoming().nextTicketNumber >= existing().nextTicketNumber &&
            incoming().nextTicketNumber <= existing().nextTicketNumber + 1 &&
            incoming().servedTodayCount >= existing().servedTodayCount &&
            incoming().servedTodayCount <= existing().servedTodayCount + 1 &&
            incoming().reviewCount >= existing().reviewCount &&
            incoming().reviewCount <= existing().reviewCount + 1)
        );
    }

    // ==================== Cross-App Bookings (PII Isolated) ====================
    match /bookings/{bookingDocId} {
      allow get: if isSignedIn() && isValidId(bookingDocId) &&
        (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(bookingDocId);

      allow create: if isSignedIn() &&
        isValidId(bookingDocId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'ACTIVE' &&
        incoming().approvalStatus == 'PENDING' &&
        incoming().handledByProvider == '' &&
        incoming().approvalNote == '' &&
        incoming().keys().hasAll([
          'userId', 'bookingId', 'ticketCode', 'queueNumber', 'venueId', 'venueName',
          'venueCity', 'venueCategory', 'venuePhone', 'customerName', 'customerPhone',
          'selectedOption', 'notes', 'optionalInfo', 'priceDinar', 'status', 'stage',
          'approvalStatus', 'handledByProvider', 'approvalNote',
          'peopleAhead', 'estimatedMinutes', 'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'bookingId', 'ticketCode', 'queueNumber', 'venueId', 'venueName',
          'venueCity', 'venueCategory', 'venuePhone', 'customerName', 'customerPhone',
          'selectedOption', 'notes', 'optionalInfo', 'priceDinar', 'status', 'stage',
          'approvalStatus', 'handledByProvider', 'approvalNote',
          'peopleAhead', 'estimatedMinutes', 'createdAtMillis', 'completedAtMillis',
          'userRating', 'userReview', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidBooking(incoming());

      allow update: if isSignedIn() &&
        isValidId(bookingDocId) &&
        incoming().userId == existing().userId &&
        incoming().bookingId == existing().bookingId &&
        incoming().ticketCode == existing().ticketCode &&
        incoming().venueId == existing().venueId &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMillis == existing().createdAtMillis &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidBooking(incoming()) && (
          (isAdmin() &&
            existing().status == 'ACTIVE' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'stage', 'approvalStatus', 'handledByProvider', 'approvalNote',
              'peopleAhead', 'estimatedMinutes', 'completedAtMillis', 'updatedAt'
            ])) ||
          (existing().userId == request.auth.uid &&
            existing().status == 'ACTIVE' &&
            incoming().status in ['COMPLETED', 'CANCELLED'] &&
            incoming().approvalStatus == existing().approvalStatus &&
            incoming().handledByProvider == existing().handledByProvider &&
            incoming().approvalNote == existing().approvalNote &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'stage', 'peopleAhead', 'estimatedMinutes', 'completedAtMillis',
              'userRating', 'userReview', 'updatedAt'
            ])) ||
          (existing().userId == request.auth.uid &&
            existing().status in ['COMPLETED', 'CANCELLED'] &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'userRating', 'userReview', 'updatedAt'
            ]))
        );
    }

    // ==================== Live Venue Queue Items (PII Isolated) ====================
    match /queue_items/{queueDocId} {
      allow get: if isSignedIn() && isValidId(queueDocId) &&
        (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(queueDocId);

      allow create: if isSignedIn() &&
        isValidId(queueDocId) &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().keys().hasAll([
          'userId', 'queueItemId', 'venueId', 'ticketNumber', 'ticketCode',
          'customerName', 'customerPhone', 'selectedOption', 'status',
          'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'queueItemId', 'venueId', 'ticketNumber', 'ticketCode',
          'customerName', 'customerPhone', 'selectedOption', 'status',
          'bookingId', 'bookingTicketCode', 'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidQueueItem(incoming());

      allow update: if isSignedIn() &&
        isValidId(queueDocId) &&
        incoming().userId == existing().userId &&
        incoming().queueItemId == existing().queueItemId &&
        incoming().ticketCode == existing().ticketCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMillis == existing().createdAtMillis &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidQueueItem(incoming()) && (
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'bookingId', 'bookingTicketCode', 'updatedAt'
            ])) ||
          (existing().userId == request.auth.uid &&
            incoming().status in ['DONE', 'SKIPPED'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ]))
        );
    }

    // ==================== Public Venue Reviews ====================
    match /reviews/{reviewDocId} {
      allow get: if isSignedIn() && isValidId(reviewDocId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(reviewDocId) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll([
          'userId', 'reviewId', 'venueId', 'authorName', 'rating', 'comment',
          'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'reviewId', 'venueId', 'authorName', 'rating', 'comment',
          'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidReview(incoming());

      allow update: if isSignedIn() &&
        isValidId(reviewDocId) &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().userId == existing().userId &&
        incoming().reviewId == existing().reviewId &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMillis == existing().createdAtMillis &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidReview(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(reviewDocId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ==================== Cross-App Support Tickets (PII Isolated) ====================
    match /support_tickets/{ticketDocId} {
      allow get: if isSignedIn() && isValidId(ticketDocId) &&
        (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(ticketDocId);

      allow create: if isSignedIn() &&
        isValidId(ticketDocId) &&
        ticketDocId == incoming().externalId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'SENT' &&
        incoming().adminReply == '' &&
        incoming().repliedByAdmin == '' &&
        incoming().keys().hasAll([
          'userId', 'externalId', 'senderName', 'senderPhone', 'category', 'requestType',
          'relatedVenueName', 'subject', 'message', 'status', 'adminReply', 'repliedByAdmin',
          'createdAtMillis', 'updatedAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'externalId', 'senderName', 'senderPhone', 'category', 'requestType',
          'relatedVenueName', 'subject', 'message', 'status', 'adminReply', 'repliedByAdmin',
          'createdAtMillis', 'updatedAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidSupportTicket(incoming());

      allow update: if isSignedIn() &&
        isValidId(ticketDocId) &&
        incoming().userId == existing().userId &&
        incoming().externalId == existing().externalId &&
        incoming().requestType == existing().requestType &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMillis == existing().createdAtMillis &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidSupportTicket(incoming()) && (
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'adminReply', 'repliedByAdmin', 'updatedAtMillis', 'updatedAt'
            ])) ||
          (existing().userId == request.auth.uid &&
            existing().status != 'CLOSED' &&
            incoming().status in ['SENT', 'DELIVERED'] &&
            incoming().adminReply == existing().adminReply &&
            incoming().repliedByAdmin == existing().repliedByAdmin &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'senderName', 'status', 'updatedAtMillis', 'updatedAt'
            ]))
        );
    }

    // ==================== Cross-App Support Messages (PII Isolated, Append-Only) ====================
    match /support_messages/{messageDocId} {
      allow get: if isSignedIn() && isValidId(messageDocId) &&
        (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(messageDocId);

      allow create: if isSignedIn() &&
        isValidId(messageDocId) &&
        messageDocId == incoming().externalMessageId &&
        incoming().keys().hasAll([
          'userId', 'externalMessageId', 'ticketExternalId', 'fromAdmin',
          'senderName', 'body', 'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'externalMessageId', 'ticketExternalId', 'fromAdmin',
          'senderName', 'body', 'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidSupportMessage(incoming()) && (
          (incoming().userId == request.auth.uid && incoming().fromAdmin == false) ||
          (isAdmin() && incoming().fromAdmin == true)
        );
    }

    // ==================== Control App Authorized Admin Registry ====================
    match /admin_users/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow delete: if isAdmin() && isValidId(adminUid);

      allow create: if isAdmin() &&
        isValidId(adminUid) &&
        incoming().keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidAdminUser(incoming(), adminUid);

      allow update: if isAdmin() &&
        isValidId(adminUid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidAdminUser(incoming(), adminUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'updatedAt']);
    }

    // ==================== Control App Staff Profiles (Admin Only) ====================
    match /admins/{adminDocId} {
      allow list: if isAdmin();
      allow get, delete: if isAdmin() && isValidId(adminDocId);

      allow create: if isAdmin() &&
        isValidId(adminDocId) &&
        incoming().keys().hasAll([
          'adminId', 'name', 'roleTitle', 'phone', 'active', 'superAdmin',
          'canManageFeatures', 'canManageVenues', 'canManageQueues', 'canReplySupport',
          'canManageProviders', 'canManageAdmins', 'canRunCommands',
          'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'adminId', 'name', 'roleTitle', 'phone', 'active', 'superAdmin',
          'canManageFeatures', 'canManageVenues', 'canManageQueues', 'canReplySupport',
          'canManageProviders', 'canManageAdmins', 'canRunCommands',
          'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidAdminProfile(incoming());

      allow update: if isAdmin() &&
        isValidId(adminDocId) &&
        incoming().adminId == existing().adminId &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMillis == existing().createdAtMillis &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidAdminProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'roleTitle', 'phone', 'active', 'superAdmin',
          'canManageFeatures', 'canManageVenues', 'canManageQueues', 'canReplySupport',
          'canManageProviders', 'canManageAdmins', 'canRunCommands', 'updatedAt'
        ]);
    }

    // ==================== Control App Service Providers (Admin Only) ====================
    match /providers/{providerDocId} {
      allow list: if isAdmin();
      allow get, delete: if isAdmin() && isValidId(providerDocId);

      allow create: if isAdmin() &&
        isValidId(providerDocId) &&
        incoming().keys().hasAll([
          'providerId', 'name', 'providerRole', 'customTitle', 'phone',
          'venueId', 'venueName', 'canAcceptTickets', 'canCallNext', 'canPauseVenue',
          'active', 'acceptedCount', 'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'providerId', 'name', 'providerRole', 'customTitle', 'phone',
          'venueId', 'venueName', 'canAcceptTickets', 'canCallNext', 'canPauseVenue',
          'active', 'acceptedCount', 'createdAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidProvider(incoming());

      allow update: if isAdmin() &&
        isValidId(providerDocId) &&
        incoming().providerId == existing().providerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMillis == existing().createdAtMillis &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidProvider(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'providerRole', 'customTitle', 'phone', 'venueId', 'venueName',
          'canAcceptTickets', 'canCallNext', 'canPauseVenue', 'active', 'acceptedCount', 'updatedAt'
        ]);
    }
  }
}
